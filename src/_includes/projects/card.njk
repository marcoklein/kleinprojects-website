<article>
  <header>
    {% dynamicImageOnHover project, project.data.coverImage, project.data.coverImageDynamic %}
  </header>
  <h2>{{ project.data.title }}</h2>
  <p>{{ project.data.description }}</p>
  <footer>
    <small>
      <time datetime="{{ project.date | datetime }}">{{ project.date | formatDate }}</time>
      {% if project.data.platforms %}
        &middot;
        {% if 'desktop' in project.data.platforms %}Desktop{% endif %}
        {% if 'desktop' in project.data.platforms and 'mobile' in project.data.platforms %}, {% endif %}
        {% if 'mobile' in project.data.platforms %}Mobile{% endif %}
      {% endif %}
    </small>
    <nav>
      {% if project.data.sourceUrl %}
        <a href="{{ project.data.sourceUrl }}" target="_blank">{{ project.data.sourceUrlText or 'GitHub' }}</a>
      {% endif %}
      {% if project.data.projectUrl %}
        <a href="{{ project.data.projectUrl }}">{{ project.data.projectUrlText }}</a>
      {% endif %}
      {% for url in project.data.urls | reverse %}
        <a href="{{ url.url }}" target="_blank">{{ url.text }}</a>
      {% endfor %}
    </nav>
  </footer>
</article>
