---
layout: 'page.njk'
navParent: blog
title: Blog
---

{%- for post in collections.posts -%}
  <article>
    <h3><a href="/{{ post.data.title | slugify }}/"><strong>{{ post.data.title }}</strong></a></h3>
    <p><small>{{ post.data.tags.join(', ') }} &middot; {{ post.data.date | formatDate }}</small></p>
    <p>{{ post.content | excerpt }}</p>
  </article>
{%- endfor -%}
